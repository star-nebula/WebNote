# ===== 本地运行产出：不发布到云端 =====
# 保留 runs/ 目录结构与 .gitkeep，但忽略所有实际运行内容
runs/*
!runs/.gitkeep

# ===== 项目私有记忆 / Agent 数据 =====
.workbuddy/
.memory/

# ===== 系统 / 编辑器杂项 =====
.DS_Store
Thumbs.db
*.tmp

# ===== Python 编译缓存 =====
__pycache__/
*.py[cod]

# ===== 密钥 / 环境变量：绝不进仓库 =====
*.key
*.env
.env
.secrets

# ASR 专用虚拟环境（本地，不入库）
.venv-asr/
