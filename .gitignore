# ===== 本地运行产出：不发布到云端 =====
# 保留 runs/ 目录结构与 .gitkeep，但忽略所有实际运行内容
runs/*
!runs/.gitkeep

# 新 run 的空骨架要进 git（随代码演化）；其余运行产物一律不入仓
!runs/_template/
!runs/_template/**

# 跑完的 run 可以挪进 _archive 存档：目录本身留一个占位，内容仍不入仓
!runs/_archive/
runs/_archive/*
!runs/_archive/.gitkeep

# ===== Agent 工具的私有位（会话重建，本机产物，不进仓）=====
# .workbuddy/ 由 WorkBuddy 自己创建；记忆本体在知识库 Projects/WebNote/，不在仓里
.workbuddy/

# ===== 本机 Agent 装配：技能 junction，不入仓 =====
/.claude/skills/
/.agents/skills/

# ===== 系统 / 编辑器杂项 =====
.DS_Store
Thumbs.db
*.tmp

# ===== Python 编译缓存 =====
__pycache__/
*.py[cod]

# ===== 密钥 / 环境变量：绝不进仓库 =====
*.key
*.env
.env
.secrets

# ASR 专用虚拟环境（本地，不入库）
.venv-asr/


# ===== 私有入口与角色原始件：只在本机 =====
# 入口 AGENTS.md 进 git（工具按这个名字加载）；本机叠加层 AGENTS.local.md 不进
/AGENTS.local.md
# 本机软链，指向知识库里的全局指令文件；提交一个指向私人库的链接，
# 别人 clone 下来会落成失效文件，还会盖住仓里真正被加载的 AGENTS.md
/CLAUDE.md
