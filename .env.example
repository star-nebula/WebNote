# 环境变量键名示意：复制为 .env 后按需填写，值一律不要提交。
# .env 已被 .gitignore 忽略；不填也不影响图文流程（零依赖可用）。

# DeepSeek Vision（tools/ds_vision.py 多图理解，仅视频画面采集需要）
DEEPSEEK_API_KEY=

# 小红书笔记（tools/extract-xhs.py 需要登录态 Cookie）
XHS_COOKIE=

# BrowserSkill（可选的浏览器桥接，操控已登录浏览器读取页面）
BROWSER_SKILL_HOME=

# faster-whisper（视频 ASR；留空用 config/default.yaml 的 asr_model）
WHISPER_MODEL=

# 知识库根目录（web-archive 落库到其下 Resources/ 与 Knowledge/）
KNOWLEDGE_ROOT=

# RapidOCR 解释器（extract-video-frames.py 的 --ocr-python 替代）
OCR_PYTHON=

# headless 浏览器可执行文件（web-archive 回归与截图用；留空自动探测 Edge/Chrome）
CHROME_PATH=
